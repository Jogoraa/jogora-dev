{
  "version": 2,
  "buildCommand": "yarn install && yarn build",
  "outputDirectory": "build",
  "framework": null,
  "installCommand": "yarn install",
  "devCommand": "yarn start",
  "env": {
    "NODE_VERSION": "18.x"
  },
  "build": {
    "env": {
      "GENERATE_SOURCEMAP": "false",
      "DISABLE_ESLINT_PLUGIN": "true"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
